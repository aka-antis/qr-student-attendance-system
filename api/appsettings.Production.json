{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "SqlServer"
  },
  "Jwt": {
    "Issuer": "AttendanceQr",
    "Audience": "AttendanceQr",
    "ExpiresMinutes": "720"
  },
  "Cors": {
    "AllowedOrigins": [ "https://your-teacher-app-host.example.com" ]
  },
  "Attendance": {
    "EnforceMeetingWindow": true,
    "GraceMinutes": 15
  }
}
